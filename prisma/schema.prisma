generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String         @id @default(cuid())
  name                String
  email               String         @unique
  passwordHash        String
  role                String         // STUDENT | PRESIDENT | ADMIN
  createdAt           DateTime       @default(now())
  society             Society?       @relation("President")
  memberships         Membership[]
  registrations       Registration[]
  invitations         Invitation[]
  tasks               Task[]         @relation("Assignee")
  notifications       Notification[]
  otps                OtpCode[]
  megaEventsPresident MegaEvent[]    @relation("MegaPresident")
  megaEventsCreated   MegaEvent[]    @relation("MegaCreator")
  supervisedSubEvents SubEvent[]     @relation("Supervisor")
}

model OtpCode {
  id            String    @id @default(cuid())
  userId        String
  codeHash      String
  expiresAt     DateTime
  attempts      Int       @default(0)
  usedAt        DateTime?
  invalidatedAt DateTime?
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model Society {
  id           String       @id @default(cuid())
  name         String       @unique
  description  String
  category     String
  contactEmail String
  contactPhone String?
  logoUrl      String?
  presidentId  String       @unique
  createdAt    DateTime     @default(now())
  president    User         @relation("President", fields: [presidentId], references: [id])
  memberships  Membership[]
  events       Event[]
  meetings     Meeting[]
  megaEvents   MegaEvent[]
}

model Membership {
  id        String   @id @default(cuid())
  societyId String
  studentId String
  status    String   @default("PENDING") // PENDING | APPROVED | REJECTED | REMOVED
  label     String   @default("MEMBER")  // MEMBER | CORE (bonus)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  society   Society  @relation(fields: [societyId], references: [id])
  student   User     @relation(fields: [studentId], references: [id])

  @@unique([societyId, studentId])
}

model Event {
  id                   String         @id @default(cuid())
  societyId            String
  title                String
  description          String
  venue                String
  startAt              DateTime
  endAt                DateTime
  registrationDeadline DateTime
  capacity             Int
  proposedBudget       Int
  approvedBudget       Int?
  approvalStatus       String         @default("DRAFT") // DRAFT|PENDING|APPROVED|REJECTED
  hasBeenApproved      Boolean        @default(false)
  isCancelled          Boolean        @default(false)
  adminRemarks         String?
  decidedAt            DateTime?
  submittedAt          DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  society              Society        @relation(fields: [societyId], references: [id])
  registrations        Registration[]
  invitations          Invitation[]
  tasks                Task[]
  expenses             Expense[]

  @@index([approvalStatus, startAt])
}

model Registration {
  id        String   @id @default(cuid())
  eventId   String
  studentId String
  status    String   @default("REGISTERED") // REGISTERED | CANCELLED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  event     Event    @relation(fields: [eventId], references: [id])
  student   User     @relation(fields: [studentId], references: [id])

  @@unique([eventId, studentId])
}

model Invitation {
  id          String    @id @default(cuid())
  eventId     String
  studentId   String
  status      String    @default("PENDING") // PENDING | ACCEPTED | DECLINED | WITHDRAWN(bonus)
  createdAt   DateTime  @default(now())
  respondedAt DateTime?
  event       Event     @relation(fields: [eventId], references: [id])
  student     User      @relation(fields: [studentId], references: [id])

  @@unique([eventId, studentId])
}

model Task {
  id          String    @id @default(cuid())
  eventId     String?
  subEventId  String?
  title       String
  description String
  priority    String    @default("MEDIUM") // LOW|MEDIUM|HIGH
  dueDate     DateTime
  status      String    @default("TODO") // TODO|IN_PROGRESS|COMPLETED
  assigneeId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  event       Event?    @relation(fields: [eventId], references: [id])
  subEvent    SubEvent? @relation(fields: [subEventId], references: [id])
  assignee    User?     @relation("Assignee", fields: [assigneeId], references: [id])

  @@index([eventId])
  @@index([subEventId])
  @@index([assigneeId])
}

model Expense {
  id         String    @id @default(cuid())
  eventId    String?
  subEventId String?
  title      String
  amount     Int
  note       String?
  spentOn    DateTime
  createdAt  DateTime  @default(now())
  event      Event?    @relation(fields: [eventId], references: [id])
  subEvent   SubEvent? @relation(fields: [subEventId], references: [id])

  @@index([eventId])
  @@index([subEventId])
}

model MegaEvent {
  id            String     @id @default(cuid())
  title         String
  description   String
  societyId     String
  presidentId   String     // = society.presidentId, set server-side
  createdById   String     // admin
  startDate     String     // "YYYY-MM-DD" (PKT calendar date)
  endDate       String     // "YYYY-MM-DD"
  overallBudget Int
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  society       Society    @relation(fields: [societyId], references: [id])
  president     User       @relation("MegaPresident", fields: [presidentId], references: [id])
  createdBy     User       @relation("MegaCreator", fields: [createdById], references: [id])
  subEvents     SubEvent[]

  @@index([createdById])
  @@index([presidentId])
}

model SubEvent {
  id              String    @id @default(cuid())
  megaEventId     String
  title           String
  description     String
  date            String    // "YYYY-MM-DD"
  startAt         DateTime  // UTC
  endAt           DateTime  // UTC
  venue           String
  supervisorId    String
  allocatedBudget Int?      // null = not allocated yet; set once
  budgetAlertSent Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  megaEvent       MegaEvent @relation(fields: [megaEventId], references: [id])
  supervisor      User      @relation("Supervisor", fields: [supervisorId], references: [id])
  tasks           Task[]
  expenses        Expense[]

  @@index([megaEventId])
  @@index([supervisorId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  message   String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId, readAt])
}

model Meeting {
  id          String          @id @default(cuid())
  societyId   String
  title       String
  startAt     DateTime
  location    String
  agenda      String
  isCancelled Boolean         @default(false)
  society     Society         @relation(fields: [societyId], references: [id])
  invites     MeetingInvite[]
}

model MeetingInvite {
  id        String  @id @default(cuid())
  meetingId String
  studentId String
  meeting   Meeting @relation(fields: [meetingId], references: [id])

  @@unique([meetingId, studentId])
}

