# Database connection for Neon Postgres (Pooled URL)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&connection_limit=25"

# Direct Database URL for migrations (Non-pooled URL)
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# JWT Authentication Secret (min 32 chars)
AUTH_SECRET="change-me-to-a-long-random-string-min-32-chars"

# Optional SMTP Email Delivery (Gmail App Password or Resend SMTP)
# If omitted, OTP codes are logged to the console in local development
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="UniSphere <no-reply@unisphere.test>"

# Optional Vercel Blob Storage Token for Image / Logo Uploads
# If omitted, uploads fall back to local public/uploads directory
BLOB_READ_WRITE_TOKEN=
